# Postgres connection string, read by drizzle.config.ts and src/db/client.ts.
# Local Docker (matches the POSTGRES_* defaults below):
#   postgres://noclash:noclash@localhost:5432/noclash
# Hosted (e.g. Supabase): use the connection string from the project's
# Database settings. The client's SSL mode is "prefer", so it negotiates
# SSL automatically — no separate flag needed for hosted vs. local.
DATABASE_URL=postgres://noclash:noclash@localhost:5432/noclash

# Postgres connection string for the test suite (pnpm test), read by
# src/test/global-setup.ts and src/test/setup.ts. Deliberately a distinct
# database name on the same server rather than derived from DATABASE_URL:
# the test harness truncates every table before each test, so it must never
# be able to resolve to a real/shared database by accident. The global
# setup creates this database automatically if it doesn't exist yet.
TEST_DATABASE_URL=postgres://noclash:noclash@localhost:5432/noclash_test

# The four variables below only matter when running Postgres locally via
# docker-compose.yml (pnpm db:up). They're irrelevant against a hosted
# database, where DATABASE_URL alone is enough. Each already has a fallback
# default in docker-compose.yml, so none of these are required — set them
# only to override the default.

# Username created inside the local Postgres container.
POSTGRES_USER=noclash

# Password for POSTGRES_USER inside the local Postgres container.
POSTGRES_PASSWORD=noclash

# Database name created inside the local Postgres container.
POSTGRES_DB=noclash

# Host port docker-compose maps to the container's 5432, in case something
# else on your machine is already using 5432.
POSTGRES_PORT=5432

# Supabase Auth. Get these from the project dashboard's Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used to build the GitHub OAuth callback URL. Update when deployed —
# defaults to localhost for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
